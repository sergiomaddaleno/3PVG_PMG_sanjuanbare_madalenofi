# Este es el archivo de materiales para Mario

newmtl MarioBody
Ka 0.3 0.3 0.3          # Color ambiental
Kd 0.8 0.3 0.3          # Color difuso (rojo para el cuerpo de Mario)
Ks 1.0 1.0 1.0          # Color especular (brillo)
Ns 100.0                # Brillo
illum 2                 # Tipo de iluminación
map_Kd mario_0.png      # Textura difusa (rojo para el cuerpo)

newmtl MarioClothes
Ka 0.3 0.3 0.3          # Color ambiental
Kd 0.5 0.5 0.5          # Color difuso (camisa, pantalones, etc.)
Ks 0.8 0.8 0.8          # Color especular (brillo)
Ns 50.0                 # Brillo
illum 2                 # Tipo de iluminación
map_Kd mario_2.png      # Textura para las prendas de Mario

newmtl MarioFace
